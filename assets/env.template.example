# Elegir y fijar tags mantenidos; no usar estos marcadores sin completar.
NODE_IMAGE=
POSTGRES_IMAGE=
# La ruta cambia segun version/imagen PostgreSQL: verificar documentacion.
POSTGRES_DATA_PATH=
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=
DATABASE_URL_DOCKER=postgresql://app:URL_ENCODED_PASSWORD@db:5432/app
# Solo para ejecución API en host o herramientas locales, con override debug.
DATABASE_URL_LOCAL=postgresql://app:URL_ENCODED_PASSWORD@localhost:5433/app
PG_HOST_PORT=5433
WEB_HOST_PORT=3100
